generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Мультиязычные поля хранятся как JSON: { "ru": "...", "en": "...", "am": "..." }

enum Role {
  CLIENT
  MASTER
  OPERATOR
  ADMIN
  OWNER
}

enum OtpChannel {
  SMS
  WHATSAPP
  TELEGRAM
}

model User {
  id          String    @id @default(cuid())
  phone       String    @unique
  name        String?
  email       String?
  role        Role      @default(CLIENT)
  locale      String    @default("ru")
  blocked     Boolean   @default(false)
  adminNotes  String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  lastLoginAt DateTime?
  /// Когда пользователь получил код из формы с уведомлением о политике конфиденциальности
  privacyConsentAt DateTime?

  sessions    Session[]
  addresses   Address[]
  orders      Order[]
  reviews     Review[]
  master      Master?
  redemptions PromoRedemption[]
  auditLogs   AuditLog[]
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
  userAgent String?
}

model OtpCode {
  id         String     @id @default(cuid())
  phone      String
  codeHash   String
  channel    OtpChannel
  expiresAt  DateTime
  attempts   Int        @default(0)
  consumedAt DateTime?
  ip         String?
  createdAt  DateTime   @default(now())

  @@index([phone, createdAt])
}

model Address {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label     String?
  district  String?
  street    String
  building  String
  entrance  String?
  floor     String?
  apartment String?
  intercom  String?
  comment   String?
  lat       Float?
  lng       Float?
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  orders    Order[]
}

model Category {
  id          String     @id @default(cuid())
  slug        String     @unique
  title       Json
  description Json?
  image       String?
  sort        Int        @default(0)
  active      Boolean    @default(true)
  comingSoon  Boolean    @default(false)
  services    Service[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model Service {
  id            String        @id @default(cuid())
  categoryId    String
  category      Category      @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  slug          String        @unique
  title         Json
  subtitle      Json?
  description   Json?
  image         String?
  bannerImage   String?
  badge         Json?
  /// Блоки страницы: howItWorks[], benefits[], faq[], policy, note — всё мультиязычно
  content       Json?
  active        Boolean       @default(true)
  sort          Int           @default(0)
  rating        Float         @default(0)
  reviewsCount  Int           @default(0)
  bookingsCount Int           @default(0)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  groups        OptionGroup[]
  plans         Plan[]
  masters       Master[]      @relation("MasterSkills")
  orders        Order[]
  reviews       Review[]
}

enum GroupType {
  SINGLE
  MULTI
}

model OptionGroup {
  id        String    @id @default(cuid())
  serviceId String
  service   Service   @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  title     Json
  hint      Json?
  /// Ссылка-пояснение под группой (например «Что входит в материалы?»)
  infoTitle Json?
  infoBody  Json?
  type      GroupType @default(SINGLE)
  required  Boolean   @default(true)
  /// Группа определяет длительность визита
  isDuration Boolean  @default(false)
  active    Boolean   @default(true)
  sort      Int       @default(0)
  options   Option[]
}

model Option {
  id           String      @id @default(cuid())
  groupId      String
  group        OptionGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  title        Json
  subtitle     Json?
  price        Int         @default(0)
  durationMin  Int         @default(0)
  /// Применяются ли к этой части цены скидки тарифа / первого визита
  discountable Boolean     @default(true)
  isDefault    Boolean     @default(false)
  badge        Json?
  /// Пример расписания: [{ icon, title: {ru,en,am}, minutes }]
  schedule     Json?
  active       Boolean     @default(true)
  sort         Int         @default(0)
}

enum PlanKind {
  ONE_TIME
  SUBSCRIPTION
  PACKAGE
}

model Plan {
  id              String   @id @default(cuid())
  serviceId       String
  service         Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  kind            PlanKind
  title           Json
  subtitle        Json?
  badge           Json?
  discountPercent Float    @default(0)
  /// SUBSCRIPTION: интервал между визитами в днях (7 = раз в неделю, 14, 28)
  intervalDays    Int?
  /// SUBSCRIPTION: визитов в неделю (для 2+ в неделю — клиент выбирает дни недели)
  visitsPerWeek   Int?
  /// PACKAGE: число визитов и срок использования
  packageVisits   Int?
  validityDays    Int?
  active          Boolean  @default(true)
  isDefault       Boolean  @default(false)
  sort            Int      @default(0)
  orders          Order[]
}

model Master {
  id             String    @id @default(cuid())
  userId         String?   @unique
  user           User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  slug           String    @unique
  name           Json
  bio            Json?
  photo          String?
  phone          String?
  experienceYears Int      @default(0)
  languages      String[]  @default([])
  /// { "1": [["10:00","19:00"]], ... } — 1=понедельник … 7=воскресенье
  workingHours   Json
  active         Boolean   @default(true)
  rating         Float     @default(0)
  reviewsCount   Int       @default(0)
  jobsCount      Int       @default(0)
  sort           Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  skills         Service[] @relation("MasterSkills")
  timeOff        TimeOff[]
  visits         Visit[]
  reviews        Review[]
  preferredIn    Order[]
}

model TimeOff {
  id       String   @id @default(cuid())
  masterId String
  master   Master   @relation(fields: [masterId], references: [id], onDelete: Cascade)
  from     DateTime
  to       DateTime
  reason   String?
}

enum OrderStatus {
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
}

enum PaymentMethod {
  CASH
  CARD
}

enum PaymentStatus {
  PENDING
  PAID
  PARTIAL
  REFUNDED
}

model Order {
  id                String        @id @default(cuid())
  number            Int           @unique @default(autoincrement())
  userId            String
  user              User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  serviceId         String
  service           Service       @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  planId            String?
  plan              Plan?         @relation(fields: [planId], references: [id], onDelete: SetNull)
  kind              PlanKind
  addressId         String?
  address           Address?      @relation(fields: [addressId], references: [id], onDelete: SetNull)
  addressSnapshot   Json
  /// Снимок выбранной конфигурации: service/plan/options c названиями на момент заказа
  config            Json
  /// Разбивка цены (результат движка цены)
  pricing           Json
  pricePerVisit     Int
  firstVisitPrice   Int
  total             Int
  durationMin       Int
  /// SUBSCRIPTION: { weekdays: [1,4], time: "11:00", intervalDays: 7 }
  recurrence        Json?
  generatedUntil    DateTime?
  pausedUntil       DateTime?
  preferredMasterId String?
  preferredMaster   Master?       @relation(fields: [preferredMasterId], references: [id], onDelete: SetNull)
  paymentMethod     PaymentMethod @default(CASH)
  paymentStatus     PaymentStatus @default(PENDING)
  status            OrderStatus   @default(ACTIVE)
  promoCodeId       String?
  promoCode         PromoCode?    @relation(fields: [promoCodeId], references: [id], onDelete: SetNull)
  comment           String?
  locale            String        @default("ru")
  source            String        @default("web")
  cancelReason      String?
  expiresAt         DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  visits            Visit[]
  redemptions       PromoRedemption[]

  @@index([userId])
  @@index([status])
}

enum VisitStatus {
  UNSCHEDULED
  SCHEDULED
  CONFIRMED
  ON_WAY
  IN_PROGRESS
  DONE
  CANCELLED
  SKIPPED
  NO_SHOW
}

model Visit {
  id              String      @id @default(cuid())
  orderId         String
  order           Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  index           Int         @default(1)
  scheduledAt     DateTime?
  durationMin     Int
  masterId        String?
  master          Master?     @relation(fields: [masterId], references: [id], onDelete: SetNull)
  status          VisitStatus @default(SCHEDULED)
  price           Int
  cashCollected   Boolean     @default(false)
  cashCollectedAt DateTime?
  startedAt       DateTime?
  finishedAt      DateTime?
  remindedAt      DateTime?
  reviewRequestedAt DateTime?
  masterNote      String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  review          Review?

  @@index([scheduledAt])
  @@index([masterId, scheduledAt])
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

model Review {
  id        String       @id @default(cuid())
  visitId   String?      @unique
  visit     Visit?       @relation(fields: [visitId], references: [id], onDelete: SetNull)
  userId    String?
  user      User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  masterId  String?
  master    Master?      @relation(fields: [masterId], references: [id], onDelete: SetNull)
  serviceId String?
  service   Service?     @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  authorName String?
  rating    Int
  text      String?
  reply     String?
  status    ReviewStatus @default(PENDING)
  createdAt DateTime     @default(now())
}

enum PromoType {
  PERCENT
  FIXED
}

model PromoCode {
  id             String    @id @default(cuid())
  code           String    @unique
  description    String?
  type           PromoType
  value          Int
  maxDiscount    Int?
  minOrder       Int?
  validFrom      DateTime?
  validTo        DateTime?
  usageLimit     Int?
  perUserLimit   Int       @default(1)
  firstOrderOnly Boolean   @default(false)
  /// Разрешить суммировать с тарифной скидкой
  stackable      Boolean   @default(false)
  serviceIds     String[]  @default([])
  planKinds      PlanKind[] @default([])
  active         Boolean   @default(true)
  usedCount      Int       @default(0)
  createdAt      DateTime  @default(now())
  orders         Order[]
  redemptions    PromoRedemption[]
}

model PromoRedemption {
  id        String    @id @default(cuid())
  promoId   String
  promo     PromoCode @relation(fields: [promoId], references: [id], onDelete: Cascade)
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderId   String
  order     Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  phone     String
  createdAt DateTime  @default(now())
}

model Banner {
  id        String   @id @default(cuid())
  title     Json
  subtitle  Json?
  image     String?
  link      String?
  promoCode String?
  bg        String?
  active    Boolean  @default(true)
  sort      Int      @default(0)
}

model Page {
  id        String   @id @default(cuid())
  slug      String   @unique
  title     Json
  body      Json
  active    Boolean  @default(true)
  updatedAt DateTime @updatedAt
}

/// Переопределение текстов интерфейса из админки
model UiString {
  id     String @id @default(cuid())
  locale String
  key    String
  value  String

  @@unique([locale, key])
}

/// Control Center: задача бэклога (тексты — src/server/backlog.ts, статусы и работа — в Control Center; правила — docs/DEV_SYSTEM.md)
model Task {
  id            String    @id @default(cuid())
  key           String    @unique
  title         String
  summary       String
  details       String?
  /// Критерии приёмки
  requirements  String[]  @default([])
  /// Дизайн: требования и заметки к интерфейсу, при необходимости
  design        String?
  /// Проверка и тестирование: что и как проверено
  qaNotes       String?
  /// Готовность к деплою: миграции, флаги, порядок выкладки
  deployNotes   String?
  /// Что нужно от продукта: аккаунты, документы, решения
  needs         String[]  @default([])
  /// Ключи задач, от которых зависит эта
  depends       String[]  @default([])
  /// Ссылки на документы и файлы
  docs          String[]  @default([])
  /// Метка эпика для старых карточек (человекочитаемая строка) — реальная связь через epicKey
  epic          String?
  /// Ключ эпика (Epic.key). Пусто — простая задача без эпика
  epicKey       String?
  epicRef       Epic?     @relation(fields: [epicKey], references: [key])
  area          String
  /// back | front | fullstack | infra | none
  layer         String
  /// p0 до первых клиентов | p1 до запуска | p2 после запуска | p3 к сведению
  priority      String
  /// launch | public | growth | later | baseline
  stage         String
  /// backlog | ready | in_progress | review | blocked | done | cancelled — переходы и гейты: src/lib/cc-flow.ts
  status        String    @default("backlog")
  /// product | tech | both
  owner         String    @default("tech")
  estimate      String?
  /// code — тексты задачи приходят из src/server/backlog.ts и обновляются при деплое
  /// ui   — задачу создали или отредактировали в админке, деплой её не трогает
  /// api  — задачу завела рабочая сессия через API, деплой её тоже не трогает
  /// intake — свободный текст из Intake (карточка IN-N), его разбирает триаж
  source        String    @default("code")
  createdBy     String?
  assignee      String?
  blockedReason String?
  /// Кто должен снять блокировку: owner | product | design | tech | external | deps
  blockedOn     String?
  sort          Int       @default(0)
  /// Аренда задачи исполнителем (API /api/cc): кто держит и до какого времени. Пульс продлевает аренду
  claimedBy     String?
  claimUntil    DateTime?
  /// Последний признак жизни исполнителя: пульс из хука Claude Code или команды scripts/cc.mjs
  heartbeatAt   DateTime?
  /// Когда сторож заметил истёкшую аренду без пульса. Пусто — с задачей всё в порядке
  staleAt       DateTime?
  /// Чат исполнителя (id сессии Claude Code), чтобы найти, кто держит задачу
  session       String?
  /// Ветка git с работой по задаче, обычно task/<КЛЮЧ>. Остаётся после возврата — следующий продолжает с неё
  branch        String?
  /// Файлы и папки, которые задача затрагивает: параллельные исполнители не берут пересекающиеся задачи
  scope         String[]  @default([])
  /// Сколько раз задачу возвращали в очередь брошенной
  reclaims      Int       @default(0)
  /// Сколько раз проверка возвращала задачу на доработку
  rework        Int       @default(0)
  /// Коммит в main, с которым задача выложена, — доказательство готовности код-задачи
  deployedSha   String?
  /// Что проверено после выкладки: smoke, живая проверка, ссылка или скриншот
  proof         String?
  /// Проверка тестировщика: какой коммит ветки проверен, кем и когда. Новый коммит в ветке требует новой проверки
  testedSha     String?
  testedBy      String?
  testedAt      DateTime?
  /// Триаж: когда и кем карточка разобрана и вердикт. Пусто у бэклога — карточка ждёт триажа (docs/roles/TRIAGE.md)
  triagedAt     DateTime?
  triagedBy     String?
  triageNote    String?
  startedAt     DateTime?
  doneAt        DateTime?
  /// Нужен макет до начала работы: ставит триаж, владелец или техдиректор; задача не уходит в «В очереди» без утверждённого макета (гейт — src/lib/cc-flow.ts)
  mockupRequired    Boolean   @default(false)
  /// Ссылка на макет (Figma, страница стенда) или имя прикреплённого файла — чтобы не открывать вложения по одному
  mockupUrl         String?
  /// Кто утвердил макет
  mockupApprovedBy  String?
  /// Когда утвердили макет
  mockupApprovedAt  DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  comments      TaskComment[]
  events        TaskEvent[]
  attachments   Attachment[]

  @@index([status, priority])
  @@index([stage])
  @@index([area])
  @@index([epicKey])
}

/// Эпик — крупная область работы с собственными требованиями, дизайном, статусом проверки и готовности к деплою.
/// Задачи привязываются через Task.epicKey; задача без эпика — «простая задача».
model Epic {
  id           String   @id @default(cuid())
  key          String   @unique
  title        String
  summary      String
  /// Продуктовые требования к эпику целиком
  requirements String[] @default([])
  /// Дизайн: принципы, ссылки на макеты, что должно быть видно пользователю
  design       String?
  /// Технические заметки: стек, архитектура, алгоритм — при необходимости
  techNotes    String?
  /// Как проверяем, что эпик готов
  testingNotes String?
  /// Что нужно для деплоя: миграции, флаги, порядок выкладки
  deployNotes  String?
  /// planned | in_progress | testing | ready | done
  status       String   @default("planned")
  /// Ключи эпиков, от которых зависит этот
  depends      String[] @default([])
  /// Ссылки на документы
  docs         String[] @default([])
  sort         Int      @default(0)
  /// code — из src/server/backlog.ts, ui — создан или отредактирован в админке
  source       String   @default("code")
  createdBy    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tasks        Task[]
  attachments  Attachment[]

  @@index([status])
}

/// Файл, прикреплённый к задаче или эпику (макет, документ, скриншот) — хранится в томе uploads,
/// который уже входит в ночной бэкап (deploy/backup.sh)
model Attachment {
  id         String   @id @default(cuid())
  taskId     String?
  task       Task?    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  epicKey    String?
  epic       Epic?    @relation(fields: [epicKey], references: [key], onDelete: Cascade)
  fileName   String
  url        String
  size       Int
  mime       String
  uploadedBy String
  createdAt  DateTime @default(now())

  @@index([taskId])
  @@index([epicKey])
}

/// Комментарий или отчёт по задаче
model TaskComment {
  id        String   @id @default(cuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  /// note — заметка человека, progress — ход работы, report — отчёт о сдаче, handoff — передача задачи,
  /// review — замечания проверки, error — ошибка (тест, сборка, выкладка), system — запись сторожа или системы
  kind      String   @default("note")
  author    String
  text      String
  createdAt DateTime @default(now())

  @@index([taskId, createdAt])
}

/// Запуск воркера (claude -p на сервере): кто, с какой задачей, чем кончилось. Пишет диспетчер через /api/cc
model WorkerRun {
  id         String    @id @default(cuid())
  /// triage | dev | tester | deployer
  pool       String
  agent      String
  taskKey    String?
  /// Карточки запуска триажа; пусто у триажа — обзор всего бэклога
  keys       String[]  @default([])
  /// Имя юнита systemd, в котором идёт запуск
  unit       String
  model      String
  /// running | done | failed | timeout | limit | stopped
  status     String    @default("running")
  summary    String?
  turns      Int?
  /// Хвост вывода запуска: ответ claude -p и ошибки — вкладка «Воркеры» → журнал
  log        String?
  tokensIn   Int?
  tokensOut  Int?
  /// Условная стоимость по расчёту claude -p; под подпиской деньги не списываются, это мера расхода лимита
  costUsd    Float?
  /// Человек нажал «Остановить»: диспетчер остановит юнит на следующем проходе
  stopRequested Boolean @default(false)
  /// Кто попросил запуск кнопкой «Запустить сейчас»; пусто — запуск по очереди
  requestedBy String?
  startedAt  DateTime  @default(now())
  finishedAt DateTime?

  @@index([status])
  @@index([startedAt])
}

/// Библиотека знаний и инструкций (как Canon в админке LIA): документы из репозитория — снимок при каждой выкладке —
/// и записи, которые ведут люди в Control Center. Каждая правка — новая версия, прошлые версии не удаляются (это и бэкап)
model LibraryDoc {
  id        String   @id @default(cuid())
  /// Для документа из репозитория — его путь (docs/WORKERS.md), для записи из админки — note-<случайный хвост>
  slug      String   @unique
  title     String
  /// rules | role | process | decision | spec | knowledge
  kind      String
  /// repo — документ репозитория, меняется только через код; admin — запись владельца или команды
  source    String
  /// Путь в репозитории (для source=repo)
  path      String?
  /// Номер текущей версии
  version   Int      @default(1)
  archived  Boolean  @default(false)
  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  versions  LibraryVersion[]

  @@index([kind])
}

model LibraryVersion {
  id        String     @id @default(cuid())
  docId     String
  doc       LibraryDoc @relation(fields: [docId], references: [id], onDelete: Cascade)
  n         Int
  title     String
  content   String
  /// sha256 содержимого: снимок при выкладке пишет новую версию, только если текст изменился
  hash      String
  author    String
  note      String?
  createdAt DateTime   @default(now())

  @@unique([docId, n])
  @@index([docId, createdAt])
}

/// Сообщение в Control Center (вкладка «Сообщения»): владелец пишет роли или воркерам, воркеры — владельцу.
/// Воркер получает непрочитанные сообщения своей роли в брифинге при запуске
model CcMessage {
  id        String    @id @default(cuid())
  /// owner | cto | triage | dev | tester | deployer | workers (все воркеры)
  toRole    String
  fromAgent String
  text      String
  taskKey   String?
  readAt    DateTime?
  readBy    String?
  createdAt DateTime  @default(now())

  @@index([toRole, readAt])
  @@index([createdAt])
}

/// История изменений задачи
model TaskEvent {
  id        String   @id @default(cuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  actor     String
  field     String
  from      String?
  to        String?
  createdAt DateTime @default(now())

  @@index([taskId, createdAt])
}

model Setting {
  key   String @id
  value Json
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  entity    String
  entityId  String?
  data      Json?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
}
