{
  "permissions": {
    "deny": [
      "Read(//var/www/**)",
      "Edit(//var/www/**)",
      "Read(//root/INFRASTRUCTURE.local.md)",
      "Read(//etc/nginx/**)",
      "Edit(//etc/nginx/**)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "timeout": 10, "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/session-start.sh" }
        ]
      }
    ]
  }
}
