# ── Обязательные ──
POSTGRES_PASSWORD=change-me-long-random
SESSION_SECRET=change-me-64-random-chars
CRON_SECRET=change-me-random
# Телефон владельца: по нему вход в админку
ADMIN_PHONE=+37400000000

# ── Адрес сайта ──
# Пока нет домена: http://ВАШ_IP и SITE_ADDRESS=:80
APP_URL=http://127.0.0.1
SITE_ADDRESS=:80
# После подключения домена и HTTPS: COOKIE_SECURE=true
COOKIE_SECURE=false

# true — код подтверждения показывается на экране (только для тестов, до подключения SMS/WhatsApp/Telegram)
OTP_DEV_MODE=false
