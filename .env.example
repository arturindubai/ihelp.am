# ── Обязательные ──
POSTGRES_PASSWORD=change-me-long-random
SESSION_SECRET=change-me-64-random-chars
CRON_SECRET=change-me-random
# Шифрование ключей интеграций в базе: openssl rand -hex 32. Храните копию .env вне сервера (менеджер паролей)
SETTINGS_ENCRYPTION_KEY=
# Ключ для API задач Control Center (агенты), openssl rand -hex 32. Пусто — API выключено
CC_AGENT_KEY=
# Токен подписки Claude для воркеров (docs/WORKERS.md): заполняет scripts/claude-login.sh. Пусто — воркеры не запускаются
CLAUDE_CODE_OAUTH_TOKEN=
# Запасной вход владельца по ссылке (пока нет каналов кода), openssl rand -hex 32. Пусто — выключено
ADMIN_LOGIN_TOKEN=

# ── Контакты (ЕДИНОЕ МЕСТО) ──
# Телефон владельца: по нему вход в админку
ADMIN_PHONE=+37400000000
# Публичные контакты бизнеса: футер, кнопка WhatsApp на главной, {{phone}}/{{email}}/... в текстах страниц.
# Пустое значение — берётся из Админка → Настройки → Компания. Заполненное — важнее админки.
# После правки: docker compose up -d (пересборка не нужна)
CONTACT_PHONE=
CONTACT_WHATSAPP=
CONTACT_TELEGRAM=
CONTACT_EMAIL=
CONTACT_INSTAGRAM=

# ── Адрес сайта ──
# Пока нет домена: http://ВАШ_IP и SITE_ADDRESS=:80
APP_URL=http://127.0.0.1
SITE_ADDRESS=:80
# Порты на хосте. Если 80/443 заняты другим сайтом (nginx): HTTP_BIND=8080, HTTPS_BIND=127.0.0.1:8443, APP_URL=http://ВАШ_IP:8080
HTTP_BIND=80
HTTPS_BIND=443
# После подключения домена и HTTPS: COOKIE_SECURE=true
COOKIE_SECURE=false
# Индексация поисковиками: до запуска закрыто; при запуске на домене — ROBOTS_TAG=all
ROBOTS_TAG=noindex, nofollow
# Сколько дней хранить бэкапы базы и фото (./backups)
BACKUP_KEEP_DAYS=14
# Время ночного бэкапа, UTC (23:30 UTC = 03:30 по Еревану)
BACKUP_AT=23:30

# true — код подтверждения показывается на экране (только для тестов, до подключения SMS/WhatsApp/Telegram)
OTP_DEV_MODE=false
