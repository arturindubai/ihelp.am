# SITE_ADDRESS=":80" — работа по IP без HTTPS.
# После покупки домена: SITE_ADDRESS="example.am, www.example.am" — Caddy сам выпустит SSL-сертификат
# (только если Caddy владеет портами 80/443 хоста; на общем сервере с nginx см. README → «Подключение домена»).

# trusted_proxies — Caddy принимает X-Forwarded-For и X-Forwarded-Proto только от приватных сетей
# (Docker-шлюз, nginx на хосте 127.0.0.1). Без этого Caddy игнорирует заголовок
# X-Forwarded-Proto: https от nginx, и Next.js генерирует абсолютные ссылки с http://.
{
	servers {
		trusted_proxies static private_ranges
	}
}

{$SITE_ADDRESS} {
	encode gzip zstd
	header {
		# ROBOTS_TAG в .env: "noindex, nofollow" до запуска, "all" — разрешить индексацию
		X-Robots-Tag "{$ROBOTS_TAG}"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options SAMEORIGIN
		-Server
		-X-Powered-By
	}
	# Два upstream: app (основной) и app-next (временный при blue-green выкладке).
	# lb_policy first: Caddy всегда выбирает первый здоровый — app, когда он работает.
	# При выкладке app-next поднимается с новым образом, Caddy переключается на него пока app
	# перезапускается, затем возвращается на app. Простоя нет.
	# health_uri: Caddy сам проверяет здоровье каждые 5 с; несуществующий app-next помечается unhealthy.
	# lb_try_duration: пассивный фоллбэк — Caddy повторяет запрос на другом upstream при ошибке соединения.
	# Размер тела запроса: везде 10 МБ, а на загрузку картинок в админке — 16 МБ
	# (файл до 12 МБ, MAX_UPLOAD_BYTES в src/lib/images.ts, плюс служебные байты multipart)
	handle /api/upload {
		request_body {
			max_size 16MB
		}
		reverse_proxy app:3000 app-next:3000 {
			lb_policy first
			health_uri /api/health
			health_interval 5s
			health_timeout 3s
			fail_duration 10s
			lb_try_duration 30s
			lb_try_interval 1s
		}
	}
	handle {
		request_body {
			max_size 10MB
		}
		reverse_proxy app:3000 app-next:3000 {
			lb_policy first
			health_uri /api/health
			health_interval 5s
			health_timeout 3s
			fail_duration 10s
			lb_try_duration 30s
			lb_try_interval 1s
		}
	}
}
