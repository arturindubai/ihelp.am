# iHelp: таймер ежемесячного обновления базовых образов.
# Срабатывает 1-го числа каждого месяца в 03:00 (время сервера).
# Если сервер был выключен в окно — запустится при следующем старте (Persistent=true).
[Unit]
Description=iHelp: таймер ежемесячного обновления образов

[Timer]
OnCalendar=*-*-01 03:00:00
AccuracySec=1h
Persistent=true

[Install]
WantedBy=timers.target
